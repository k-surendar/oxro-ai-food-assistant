# Copy this file to .env and fill in real values. NEVER commit .env to git.

# Gemini API key (required for AI responses). Rotate any key that has been
# exposed in plaintext files; configure the new key only via environment
# variables. Without it the process still starts in degraded mode
# (/ready = 503); a restart is required after setting or changing it.
GEMINI_API_KEY=

# Shared server-to-server API key that the OXRO Node.js backend must
# send as the X-API-Key header on every protected request (required).
# Generate a strong random value (e.g. Python: secrets.token_urlsafe(32))
# and store it ONLY in the local, git-ignored .env - never in code, logs,
# responses, docs or git. Fail-closed: if neither variable below is set on
# the server, every protected request is rejected with 503
# auth_not_configured. Prefer CHATBOT_API_KEY; API_KEY remains as a legacy
# fallback for older deployments.
CHATBOT_API_KEY=

# Legacy fallback: used only when CHATBOT_API_KEY is unset or empty.
API_KEY=

# Comma-separated CORS allow-list for browser (website) clients, e.g.
# http://localhost:3000. Fail-closed: if unset/empty, no browser origin is
# allowed. Mobile apps are not affected by CORS.
CORS_ORIGINS=

# Application log level (DEBUG/INFO/WARNING/ERROR/CRITICAL).
# Invalid values fall back to INFO. (default INFO)
LOG_LEVEL=INFO

# Customer session lifetime in seconds. Invalid or non-positive values
# fall back to the default. (default 3600)
SESSION_TTL_SECONDS=3600

# Maximum number of simultaneous sessions. New customers are rejected with
# 503 session_capacity_reached while full; expired sessions are swept
# first. Invalid or non-positive values fall back to the default.
# (default 500)
MAX_SESSIONS=500

# Rate limiting (always enabled, per process; limits reset on restart and
# are not shared between multiple workers). Invalid, zero or negative
# values fall back to the defaults.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_CUSTOMER_REQUESTS=20
RATE_LIMIT_AUTH_FAILURES=10

# Listen port inside the Docker container (used by the container CMD and
# its health check, not read by the Python code). (default 8000)
PORT=8000

# Documentation endpoints (/docs, /redoc, /openapi.json). Disabled by
# default; enabled only when set to exactly "true" (case-insensitive).
# Any other value keeps them disabled. Changing this requires an
# application restart.
DOCS_ENABLED=false

# Base URL of the OXRO backend used by the read-only backend_client
# module (list restaurants, restaurant details, menu, food search).
# NEVER hardcode this value in Python source. Leave empty to fail closed
# (backend_client returns base_url_not_configured without calling out).
# Example: https://your-oxro-backend-host.example
OXRO_BACKEND_BASE_URL=
